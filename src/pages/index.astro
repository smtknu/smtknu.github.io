---
import BaseLayout from '../layouts/BaseLayout.astro';
import { news } from '../data/news';
const recentNews = news.slice(0, 2);
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <h1><em>Soft Matter</em> Theory Lab</h1>
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>News</h2>
        <div class="divider"></div>
      </div>

      <div class="news-grid">
        {recentNews.map(item => (
          <article class="news-card card">
            <div class="news-meta">
              <span class:list={['tag', { 'tag-accent': item.tag === 'Award', 'tag-pub': item.tag === 'Publication' }]}>{item.tag}</span>
              <time>{item.date}</time>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a href="/news" class="news-read">Read more →</a>
          </article>
        ))}
      </div>

      <div class="section-cta">
        <a href="/news" class="btn btn-outline">All News</a>
      </div>
    </div>
  </section>

  <!-- Research Areas -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Research Areas</h2>
        <div class="divider"></div>
      </div>

      <div class="research-grid">
        <a href="/research#single-molecule" class="research-card">
          <div class="research-icon">🧬</div>
          <h3>Single Molecule Physics</h3>
          <p>Force-extension relations, conformational fluctuations, and the thermodynamics of single-molecule systems using statistical mechanics.</p>
          <span class="research-link">Learn more →</span>
        </a>
        <a href="/research#polymer-networks" class="research-card">
          <div class="research-icon">🕸️</div>
          <h3>Polymer Networks</h3>
          <p>Structure and mechanics of crosslinked polymer networks, including gels and elastomers, connecting network topology with mechanical response.</p>
          <span class="research-link">Learn more →</span>
        </a>
      </div>
    </div>
  </section>


</BaseLayout>

<style>
  .hero {
    background: var(--color-bg-dark);
    color: #fff;
    position: relative;
    overflow: hidden;
    min-height: 36vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 65% 50%, rgba(200, 16, 46, 0.35) 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero-images {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 860px;
  }

  .hero-img-slot {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    border: 2px dashed rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }


  .hero-text h1 {
    color: #fff;
    margin-bottom: 1.25rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .hero-text h1 em {
    font-style: normal;
    color: #ff8899;
  }

  .hero-text p {
    color: rgba(255,255,255,0.72);
    font-size: 1.1rem;
    max-width: 34em;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-outline-white {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 600;
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.4);
    transition: all 0.2s;
    text-decoration: none;
  }

  .btn-outline-white:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.7);
    color: #fff;
  }

.hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.4);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .scroll-arrow {
    width: 20px;
    height: 20px;
    border-right: 2px solid rgba(255,255,255,0.3);
    border-bottom: 2px solid rgba(255,255,255,0.3);
    transform: rotate(45deg);
    animation: bounce 1.5s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: rotate(45deg) translateY(0); }
    50% { transform: rotate(45deg) translateY(4px); }
  }

  .research-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .research-card {
    width: 320px;
    max-width: 100%;
  }

  .research-card {
    display: block;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .research-card::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-primary);
    transform: scaleX(0);
    transition: transform 0.25s;
  }

  .research-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    color: var(--color-text);
  }

  .research-card:hover::before { transform: scaleX(1); }

  .research-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .research-card h3 { font-size: 1.05rem; margin-bottom: 0.6rem; }
  .research-card p { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1.25rem; line-height: 1.6; }
  .research-link { font-size: 0.85rem; font-weight: 600; color: var(--color-primary-light); }

  .pub-list { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 2.5rem; }

  .pub-item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 4px solid var(--color-primary);
    transition: box-shadow 0.2s;
  }
  .pub-item:hover { box-shadow: var(--shadow-md); }

  .pub-title { font-size: 1.05rem; color: var(--color-primary); }
  .pub-authors { font-size: 0.88rem; color: var(--color-text-muted); margin: 0; }

  .pub-links { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .pub-links .btn { font-size: 0.8rem; padding: 0.35rem 0.9rem; }

  .news-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .news-card {
    width: 380px;
    max-width: 100%;
  }

  .news-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
  .news-meta time { font-size: 0.82rem; color: var(--color-text-muted); }
  .news-card h3 { font-size: 1rem; margin-bottom: 0.5rem; line-height: 1.4; }
  .news-card p { font-size: 0.88rem; color: var(--color-text-muted); margin-bottom: 0.75rem; }
  .news-read { font-size: 0.85rem; font-weight: 600; color: var(--color-primary-light); }

  .section-cta { text-align: center; }

  .director-block {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 860px;
    margin: 0 auto;
    background: #fff;
    border-radius: var(--radius);
    padding: 2.5rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .avatar-placeholder {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }

  .director-info .section-label { display: block; margin-bottom: 0.4rem; }
  .director-info h2 { margin-bottom: 0.3rem; }
  .director-title { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1rem; }
  .director-info p:last-of-type { font-size: 0.95rem; line-height: 1.7; margin-bottom: 1.5rem; }

  .director-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .director-block { grid-template-columns: 1fr; text-align: center; }
    .avatar-placeholder { margin: 0 auto; }
    .director-actions { justify-content: center; }
  }
</style>
